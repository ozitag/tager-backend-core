{
  "name": "ozitag/tager-backend-core",
  "description": "Backend Core for all projects",
  "license": "MIT",
  "homepage": "https://github.com/ozitag/tager-backend-core",
  "authors": [
    {
      "name": "Vital Ozierski <v.ozierski@ozitag.com>",
      "email": "v.ozierski@ozitag.com",
      "homepage": "https://ozitag.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.5",
    "laravel/framework": "^13.0",
    "laravel/tinker": "^3.0",
    "guzzlehttp/guzzle": "^7.8|^8.0",
    "sentry/sentry-laravel": "^4.29",
    "kalnoy/nestedset": "^7.0",
    "predis/predis": "^3.0",
    "ozitag/tager-backend-http-cache": "^2.0",
    "ozitag/tager-backend-utils": "^2.0",
    "ozerich/laravel-filestorage-db": "^0.6.26",
    "doctrine/dbal": "^4.5"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/sail": "^1.69",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "spatie/laravel-ignition": "^2.12"
  },
  "autoload": {
    "psr-4": {
      "OZiTAG\\Tager\\Backend\\Core\\": "src"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
